{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab ActionRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "actionId", "expectedObservationSeq", "tool", "args", "deadlineMonotonicMs"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string", "minLength": 1 },
    "actionId": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,128}$" },
    "expectedObservationSeq": { "type": "integer", "minimum": 0 },
    "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,40}$" },
    "args": { "type": "object" },
    "deadlineMonotonicMs": { "type": "number", "minimum": 0 },
    "taskId": { "type": "string", "maxLength": 128 }
  }
}
